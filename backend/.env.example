# Copy to backend/.env for local development. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite (backend/db.sqlite3) by default, nothing to install.
DB_ENGINE=sqlite

# To switch to PostgreSQL later, set DB_ENGINE=postgres and fill these in:
# POSTGRES_DB=pgsaas
# POSTGRES_USER=pgsaas
# POSTGRES_PASSWORD=pgsaas
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Uploaded listing photos and rental agreements (default: backend/media).
# MEDIA_ROOT=/path/to/media

# New marketplace listings wait for the platform team to verify them. Off locally by default.
# LISTINGS_REQUIRE_VERIFICATION=false

# Email (rent reminders, application updates). By default emails are printed in the terminal.
# To send real email, e.g. through an SMTP provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PG Manager <no-reply@example.com>

# Payment gateways for membership plans. Use TEST keys until you go live.
# Razorpay: Dashboard → Test mode → Settings → API Keys (key id starts with rzp_test_)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=        # Settings → Webhooks, event payment.captured
# Cashfree: Developers → API Keys (Test)
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox
# Paytm (not switched on yet, see docs)
# PAYTM_MID=
# PAYTM_MERCHANT_KEY=
# APP_BASE_URL=http://localhost:5173   # where Cashfree sends the owner back after paying

# --- SMS gateways for mobile codes (switch them on in Platform -> SMS gateways) ---
# APITxT (apitxt.com) - the default: auth key from API Keys; SMS template ID optional
# APITXT_AUTH_KEY=
# APITXT_TEMPLATE_ID=
# 2Factor (2factor.in): API key, and your DLT-approved OTP template name (optional)
# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE=
# Fast2SMS (fast2sms.com): API key, then EITHER the OTP template ID
# FAST2SMS_API_KEY=
# FAST2SMS_OTP_ID=
# OR the DLT sender ID + DLT message ID (DLT Manager); the template's {#var#} gets the code
# FAST2SMS_SENDER_ID=
# FAST2SMS_MESSAGE_ID=
